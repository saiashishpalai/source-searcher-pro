    <path
      stroke="url(#accentGradient)"
      strokeWidth="2"
      strokeLinecap="round"
      d="M16 4L16 8M16 24L16 28M4 16L8 16M24 16L28 16M6.34 6.34L9.17 9.17M22.83 22.83L25.66 25.66M6.34 25.66L9.17 22.83M22.83 9.17L25.66 6.34"
