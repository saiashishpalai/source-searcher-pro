const Haven7Icon = ({ className = "" }: { className?: string }) => (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 32 32"
    className={className}
  >
    <defs>
      <linearGradient id="haven7Gradient" x1="0%" y1="0%" x2="100%" y2="100%">
