# ⚠️ CRITICAL: Keep this secret! Only use server-side
SUPABASE_SERVICE_ROLE_KEY=<paste-your-service-role-key-here>

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Google OAuth Configuration
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<paste-your-google-client-id>
GOOGLE_CLIENT_SECRET=<paste-your-google-client-secret>

# ============================================
# Slack OAuth Configuration
# ============================================
# Get from: https://api.slack.com/apps → Your App → Basic Information
SLACK_CLIENT_ID=<paste-your-slack-client-id>
SLACK_CLIENT_SECRET=<paste-your-slack-client-secret>

# ============================================
# Notion OAuth Configuration
# ============================================
# Get from: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=<paste-your-notion-client-id>
NOTION_CLIENT_SECRET=<paste-your-notion-client-secret>
NOTION_REDIRECT_URI=http://localhost:8080/api/auth/notion/callback

# ============================================
# App URLs
# ============================================
VITE_APP_URL=http://localhost:8080

# For local development (without ngrok)
VITE_API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# For ngrok HTTPS tunnel (required for Slack OAuth)
# Uncomment and update when using ngrok:
# VITE_API_URL=https://<your-ngrok-subdomain>.ngrok.io
# API_BASE_URL=https://<your-ngrok-subdomain>.ngrok.io

# ============================================
# OpenAI Configuration
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<paste-your-openai-api-key>

# ============================================
# NGROK SETUP (Required for Slack OAuth)
# ============================================
# 
# Slack requires HTTPS for OAuth redirects. To test locally:
# 
# 1. Install ngrok: https://ngrok.com/download
# 2. Start tunnel: ./ngrok http 3000
# 3. Copy the HTTPS URL (e.g., https://abc123.ngrok.io)
# 4. Update VITE_API_URL and API_BASE_URL above
# 5. Update Slack redirect URL at: https://api.slack.com/apps
# 6. Restart your server
# 
# Note: Free ngrok URLs change on restart!
# ============================================

