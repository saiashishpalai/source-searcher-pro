# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# App URLs - HTTPS for local development with mkcert
# ============================================
VITE_API_URL=https://localhost:3000
API_BASE_URL=https://localhost:3000
VITE_APP_URL=https://localhost:8080

# ============================================
# Google OAuth Configuration
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<paste-your-google-client-id>
GOOGLE_CLIENT_SECRET=<paste-your-google-client-secret>
VITE_GOOGLE_CLIENT_ID=<paste-your-google-client-id>

# ============================================
# Slack OAuth Configuration
# ============================================
# Get from: https://api.slack.com/apps → Your App → Basic Information
SLACK_CLIENT_ID=<paste-your-slack-client-id>
SLACK_CLIENT_SECRET=<paste-your-slack-client-secret>
VITE_SLACK_CLIENT_ID=<paste-your-slack-client-id>

# ============================================
# Notion OAuth Configuration
# ============================================
# Get from: https://www.notion.so/my-integrations
