# ==========================================
# Cursor AI - Ignore patterns
# Files that should not be indexed by Cursor
# ==========================================

# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# Build outputs
# ==========================================
dist/
dist-ssr/
build/
.next/
out/
*.tsbuildinfo

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend.log
server.log

# ==========================================
# Environment files (sensitive data)
# ==========================================
.env
.env.local
.env.local.backup
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Lock files (large, no need to index)
# ==========================================
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# ==========================================
# Cache directories
# ==========================================
.cache/
.parcel-cache/
.vite/
.turbo/
.vercel/

# ==========================================
# Test coverage
# ==========================================
coverage/
.nyc_output/
*.lcov

# ==========================================
# Temporary files
# ==========================================
tmp/
temp/
*.tmp
*.temp
temp_fix.txt
*.bak
*.backup

# ==========================================
# OS generated files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# Editor files (keep .cursor visible for Cursor settings)
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ==========================================
# Binary and media files (no need to index)
# ==========================================
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.mp4
*.mp3
*.mov
*.avi
*.wav
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.webp
*.pdf
*.woff
*.woff2
*.ttf
*.eot
*.otf

# ==========================================
# Minified files
# ==========================================
*.min.js
*.min.css
*.bundle.js
*.chunk.js

# ==========================================
# Supabase local
# ==========================================
.supabase/

# ==========================================
# Documentation that doesn't need indexing
# ==========================================
# Uncomment if you don't want docs indexed
# docs/
# *.md

