# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL (for Vite frontend)
VITE_SUPABASE_URL=your-supabase-url-here

# Your Supabase anon/public key (for Vite frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server Configuration
PORT=3000

# Your Supabase service role key (KEEP THIS SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Note: Set this in Google Cloud Console as the authorized redirect URI
# http://localhost:8080/api/auth/drive/callback

# Slack OAuth Configuration
# Get these from Slack App Settings > OAuth & Permissions
# IMPORTANT: Slack requires HTTPS for OAuth redirect URIs
# For local development, use ngrok to create an HTTPS tunnel (see below)
SLACK_CLIENT_ID=your-slack-client-id-here
SLACK_CLIENT_SECRET=your-slack-client-secret-here
# Note: This is just a reference - actual redirect URI is set dynamically via API_BASE_URL

# Notion OAuth Configuration
# Get these from Notion Integration settings
NOTION_CLIENT_ID=your-notion-client-id-here
NOTION_CLIENT_SECRET=your-notion-client-secret-here
NOTION_REDIRECT_URI=http://localhost:8080/api/auth/notion/callback

# Zoho Cliq OAuth Configuration
# Get these from Zoho API Console > Create New Client
ZOHO_CLIQ_CLIENT_ID=your-zoho-cliq-client-id-here
ZOHO_CLIQ_CLIENT_SECRET=your-zoho-cliq-client-secret-here
ZOHO_CLIQ_REDIRECT_URI=https://localhost:3000/api/auth/cliq/callback

# App Configuration
VITE_APP_URL=http://localhost:8080

# API Configuration
VITE_API_URL=http://localhost:3000
# For ngrok HTTPS tunnel (required for Slack OAuth):
# VITE_API_URL=https://your-ngrok-url.ngrok.io

# API Base URL (used by server for OAuth callbacks)
# For local development without ngrok:
API_BASE_URL=http://localhost:3000
# For ngrok HTTPS tunnel (REQUIRED for Slack OAuth):
# API_BASE_URL=https://your-ngrok-url.ngrok.io

# OpenAI Configuration (Required for embeddings and search)
OPENAI_API_KEY=your-openai-api-key-here

# Sync Limits Configuration (Optional - defaults provided)
# These control how many items are synced per source
MAX_GOOGLE_DRIVE_FILES=1000
MAX_NOTION_PAGES=500
MAX_SLACK_CHANNELS=100
MAX_SLACK_MESSAGES_PER_CHANNEL=1000
MAX_ZOHO_CLIQ_CHANNELS=10
MAX_ZOHO_CLIQ_MESSAGES_PER_CHANNEL=100
MAX_CHUNKS_PER_DOCUMENT=10

# Development
NODE_ENV=development

# ==============================================================================
# NGROK SETUP FOR LOCAL DEVELOPMENT (Required for Slack OAuth)
# ==============================================================================
# Slack requires HTTPS redirect URIs. To test locally:
# 
# 1. Start ngrok tunnel:
#    ./ngrok http 3000
#
# 2. Copy the HTTPS URL (e.g., https://abc123.ngrok.io)
#
# 3. Update these variables in your .env.local:
#    VITE_API_URL=https://abc123.ngrok.io
#    API_BASE_URL=https://abc123.ngrok.io
#
# 4. Update Slack App Settings:
#    - Go to: https://api.slack.com/apps
#    - Your App > OAuth & Permissions > Redirect URLs
#    - Add: https://abc123.ngrok.io/api/auth/slack/callback
#
# 5. Restart your server for changes to take effect
#
# Note: ngrok URLs change on restart (unless you have a paid account)
# ==============================================================================
