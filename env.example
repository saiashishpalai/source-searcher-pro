# Your Supabase service role key (KEEP THIS SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Note: Set this in Google Cloud Console as the authorized redirect URI
# http://localhost:8080/api/auth/drive/callback

# Slack OAuth Configuration
# Get these from Slack App Settings > OAuth & Permissions
SLACK_CLIENT_ID=your-slack-client-id-here
SLACK_CLIENT_SECRET=your-slack-client-secret-here
SLACK_REDIRECT_URI=http://localhost:8080/api/auth/slack/callback

# Notion OAuth Configuration
# Get these from Notion Integration settings
NOTION_CLIENT_ID=your-notion-client-id-here
NOTION_CLIENT_SECRET=your-notion-client-secret-here
NOTION_REDIRECT_URI=http://localhost:8080/api/auth/notion/callback

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:8080

# API Configuration
VITE_API_URL=http://localhost:3000

# Development
NODE_ENV=development
