# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL (for Vite frontend)
VITE_SUPABASE_URL=your-supabase-url-here

# Your Supabase anon/public key (for Vite frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server Configuration
PORT=3000

# Your Supabase service role key (KEEP THIS SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# OAUTH CREDENTIALS - USER-PROVIDED (NOT NEEDED IN ENV)
# =============================================================================
# Haven7 now uses user-provided OAuth credentials!
# Each user creates their own OAuth apps and provides credentials in the UI.
# 
# You DO NOT need to set OAuth environment variables anymore.
# The following variables have been REMOVED:
#   - GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   - SLACK_CLIENT_ID, SLACK_CLIENT_SECRET  
#   - NOTION_CLIENT_ID, NOTION_CLIENT_SECRET
#
# EXCEPTION: Todoist OAuth credentials are still required in environment:
#   TODOIST_CLIENT_ID=your-todoist-client-id
#   TODOIST_CLIENT_SECRET=your-todoist-client-secret
#
# See docs/setup/USER_OAUTH_SETUP_GUIDE.md for user setup instructions.
# =============================================================================

# App Configuration
VITE_APP_URL=http://localhost:8080

# API Configuration
VITE_API_URL=http://localhost:3000
# For ngrok HTTPS tunnel (required for Slack OAuth):
# VITE_API_URL=https://your-ngrok-url.ngrok.io

# API Base URL (used by server for OAuth callbacks)
# For local development without ngrok:
API_BASE_URL=http://localhost:3000
# For ngrok HTTPS tunnel (REQUIRED for Slack OAuth):
# API_BASE_URL=https://your-ngrok-url.ngrok.io

# OpenAI Configuration (Required for embeddings and search)
OPENAI_API_KEY=your-openai-api-key-here

# Sync Limits Configuration (Optional - defaults provided)
# These control how many items are synced per source
MAX_GOOGLE_DRIVE_FILES=1000
MAX_NOTION_PAGES=500
MAX_SLACK_CHANNELS=100
MAX_SLACK_MESSAGES_PER_CHANNEL=1000
MAX_CHUNKS_PER_DOCUMENT=10

# n8n Integration (for HubSpot and WATI)
# Get this URL from your n8n workflow webhook node
# This is used by the backend server to forward webhook calls
N8N_WEBHOOK_URL=https://yzpubzyxjubarraaix.app.n8n.cloud/webhook/your-webhook-path
# Legacy: kept for reference, but backend uses N8N_WEBHOOK_URL
VITE_N8N_WEBHOOK_URL=https://yzpubzyxjubarraaix.app.n8n.cloud/webhook/your-webhook-path

# Development
NODE_ENV=development

# ==============================================================================
# NGROK SETUP FOR LOCAL DEVELOPMENT (Required for Slack OAuth)
# ==============================================================================
# Slack requires HTTPS redirect URIs. To test locally:
# 
# 1. Start ngrok tunnel:
#    ./ngrok http 3000
#
# 2. Copy the HTTPS URL (e.g., https://abc123.ngrok.io)
#
# 3. Update these variables in your .env.local:
#    VITE_API_URL=https://abc123.ngrok.io
#    API_BASE_URL=https://abc123.ngrok.io
#
# 4. Update Slack App Settings:
#    - Go to: https://api.slack.com/apps
#    - Your App > OAuth & Permissions > Redirect URLs
#    - Add: https://abc123.ngrok.io/api/auth/slack/callback
#
# 5. Restart your server for changes to take effect
#
# Note: ngrok URLs change on restart (unless you have a paid account)
# ==============================================================================
